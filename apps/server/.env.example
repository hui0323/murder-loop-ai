AI_SERVER_PORT=8788

# Provider-level configuration. Any OpenAI-compatible service can be used by filling API_KEY, BASE_URL and MODEL.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

DUCKINGMIND_API_KEY=
DUCKINGMIND_BASE_URL=https://api.duckingmind.com/v1
DUCKINGMIND_MODEL=gpt-4o-mini

# Role-level routing. Supported providers: openai, deepseek, duckingmind.
AI_PARSE_PROVIDER=deepseek
AI_KILLER_PROVIDER=duckingmind
AI_NARRATOR_PROVIDER=duckingmind
AI_NPC_PROVIDER=duckingmind
AI_RECAP_PROVIDER=deepseek

# Optional per-role model override.
AI_PARSE_MODEL=
AI_KILLER_MODEL=
AI_NARRATOR_MODEL=
AI_NPC_MODEL=
AI_RECAP_MODEL=
